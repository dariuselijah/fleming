    {
      "id": "permit_body",
      "type": "text",
      "x": 112,
      "y": 256,
      "width": 566,
      "height": 112,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2012,
      "version": 1,
      "versionNonce": 2013,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "- LLM tool calls to Medprax through Fleming's backend\n- Automatic update of draft claim line items using returned data\n- Display of returned lookup results to authorised users\n- Storage of the final reviewed claim record for billing and audit\n- Agreed usage telemetry so Medprax can see legitimate AI-driven usage",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- LLM tool calls to Medprax through Fleming's backend\n- Automatic update of draft claim line items using returned data\n- Display of returned lookup results to authorised users\n- Storage of the final reviewed claim record for billing and audit\n- Agreed usage telemetry so Medprax can see legitimate AI-driven usage",
      "lineHeight": 1.25
    },
