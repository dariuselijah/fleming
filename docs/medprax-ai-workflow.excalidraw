    {
      "id": "assurance_text",
      "type": "text",
      "x": 95,
      "y": 2068,
      "width": 1270,
      "height": 126,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2164,
      "version": 1,
      "versionNonce": 2165,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Fleming will use the LLM as an automation layer that can call Medprax through Fleming's backend to validate and enrich draft claim line items. The draft claim may be updated automatically, but it is not submitted until a doctor or biller reviews it. Medprax remains the source of truth for live product, NAPPI, tariff, plan, and fee validation. Fleming stores only the final operational claim and audit record required for patient care, billing, and compliance. Medprax proprietary data is not copied into a Fleming catalogue, vector database, RAG system, or training set.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Fleming will use the LLM as an automation layer that can call Medprax through Fleming's backend to validate and enrich draft claim line items. The draft claim may be updated automatically, but it is not submitted until a doctor or biller reviews it. Medprax remains the source of truth for live product, NAPPI, tariff, plan, and fee validation. Fleming stores only the final operational claim and audit record required for patient care, billing, and compliance. Medprax proprietary data is not copied into a Fleming catalogue, vector database, RAG system, or training set.",
      "lineHeight": 1.25
    }
